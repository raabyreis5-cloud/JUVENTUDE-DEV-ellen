<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Formulário</title>
</head>
<body>

    <form action="#" method="post">
        
        <!-- Termos de aceite -->
        <div>
            <input type="checkbox" id="aceite" name="aceite" value="sim">
            <label for="aceite">Aceito os termos</label>
        </div>

        <br>

        <!-- Gênero (Radios) -->
        <div>
            <label>Gênero:</label><br>
            <input type="radio" id="fem" name="genero" value="feminino">
            <label for="fem">Feminino</label><br>

            <input type="radio" id="masc" name="genero" value="masculino">
            <label for="masc">Masculino</label><br>

            <input type="radio" id="outro" name="genero" value="outros">
            <label for="outro">Outros</label>
        </div>

        <br>

        <!-- Idade (Alterado para number para fazer sentido com idade, ou mantido como texto/senha se preferir) -->
        <div>
            <label for="idade">Sua idade:</label><br>
            <input type="number" id="idade" name="idade" placeholder="Digite sua idade">
        </div>

        <br>

        <!-- Assunto (Select) -->
        <div>
            <label for="assunto">Assunto:</label><br>
            <select name="assunto" id="assunto">
                <option value="duvida">Dúvida</option>
                <option value="elogio">Elogio</option>
                <option value="reclamacao">Reclamação</option>
            </select>
        </div>

        <br>

        <!-- Mensagem (Textarea) -->
        <div>
            <label for="mensagem">Mensagem:</label><br>
            <textarea name="mensagem" id="mensagem" rows="5" placeholder="Escreva sua mensagem"></textarea>
        </div>

        <br>

        <!-- Botão de Envio -->
        <div>
            <button type="submit">Enviar</button>
        </div>

    </form>

</body>
</html>