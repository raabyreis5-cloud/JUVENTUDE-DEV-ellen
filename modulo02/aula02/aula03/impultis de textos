<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Formulário</title>

<form action="#" method="post">
    
    <input type="checkbox" id="aceite" name="aceite" value="sim">
    <label for="aceite">aceito os termos</label>
    <br><br>

    <input type="radio" id="feminino" name="genero" value="feminino">
    <label for="feminino">feminino</label>
    <br>

    <input type="radio" id="masculino" name="genero" value="masculino">
    <label for="masculino">homem</label>
    <br>

    <input type="radio" id="outros" name="genero" value="outros">
    <label for="outros">outros</label>
    <br><br>

    <label for="idade">sua idade:</label>
    <input type="text" id="idade" name="idade">
    <br><br>

    <select name="assunto">
        <option value="duvida">duvida</option>
        <option value="elogio">elogio</option>
        <option value="reclamacao">reclamacao</option>
    </select>
    <br><br>

    <textarea name="mensagem" rows="5" placeholder="escreva sua mensagem"></textarea>
    <br><br>

    <button type="submit">enviar</button>

</form>

</html>